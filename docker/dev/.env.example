# 개발 서버(EC2)의 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 저장소에 넣지 않는다(.gitignore). 실제 값은 이 파일에 적지 않는다.

# 개발 서버 도메인 (예시 값 — 실제 도메인은 정해지면 넣는다)
DEV_DOMAIN=dev.example.com

# 관리자 앱 도메인 (예시 값). 공개 사이트와 다른 도메인으로 접속한다(세션 쿠키가 도메인별로 갈라진다)
ADMIN_DOMAIN=admin.dev.example.com

# 앱 이미지 (server/api/Dockerfile 로 만든 것)
ROBOYAM_IMAGE=roboyam-api:dev

# 관리자 앱 이미지 (server/admin/Dockerfile 로 만든 것)
ROBOYAM_ADMIN_IMAGE=roboyam-admin:dev

# PostgreSQL 사용자
DB_USERNAME=roboyam

# postgres 컨테이너가 쓰는 평문 비밀번호(DB 를 처음 만들 때 정해진다).
POSTGRES_PASSWORD=

# 앱이 쓰는 DB 비밀번호 — 위 비밀번호를 암호화한 ENC(...) 값. 만드는 법은 아래 "암호화 키"
DB_PASSWORD=

# 암호화 키 (base64 32바이트). 새로 만들기: SecretCipherTool keygen
#   java -cp roboyam-api.jar -Dloader.main=com.community.zconfiguration.crypto.SecretCipherTool \
#        org.springframework.boot.loader.launch.PropertiesLauncher keygen
# DB_PASSWORD 를 암호화할 때도 같은 도구(encrypt)를 이 키로 쓴다. 키를 잃으면 암호문을 풀 수 없으니 안전한 곳에 따로 백업한다
ROBOYAM_CRYPTO_KEY=

# Snowflake ID 서버 번호 (0~1023). 개발 서버는 한 대라 아무 값이나 되지만 비워 둘 수는 없다
NODE_ID=1
# 관리자 앱의 Snowflake ID 서버 번호 — 앱(NODE_ID)과 달라야 한다
ADMIN_NODE_ID=2

# 설치 마법사(/install) 토큰 — 서버를 처음 띄우면 설치 전 상태이고 브라우저 /install 에서 설치를 마쳐야 쓸 수 있다.
# 비우면 서버가 뜰 때 무작위 토큰(24자)을 만들어 로그에 한 번 출력한다: docker compose logs app 에서 "설치 토큰" 줄을 찾는다(서버를 다시 띄우면 새 토큰이 된다).
# 자동 설치이거나 서버를 여러 대 띄우면 직접 정한 긴 무작위 값(영숫자 . _ - 8~128자)을 넣는다. 설치가 끝나면 쓰이지 않는다.
# ROBOYAM_INSTALL_TOKEN=

# (선택) 관리자 앱 주소 — 로그인한 최고 관리자에게 "관리자 앱" 링크를 보이는 데 쓴다(http(s):// 로 시작). 비우면 링크가 없다
# ADMIN_URL=https://admin.dev.example.com

# (선택) 화면 주소 = 개발 서버 화면 주소 (https://<DEV_DOMAIN>)
# PUBLIC_URL=https://dev.example.com

# (선택)
# JAVA_OPTS=-Xmx1g
# ADMIN_JAVA_OPTS=-Xmx512m
