# 운영 앱 서버의 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 저장소에 넣지 않는다(.gitignore). 실제 값은 이 파일에 적지 않는다.
#
# 기본은 이 값들을 환경 변수(.env)로 직접 등록하는 것이다. AWS Secrets Manager 등에서 읽는 것은 옵션이며,
# 그렇게 해도 앱이 받는 변수 이름은 같다.

# 앱 이미지 (ECR 등 — 태그는 dev 에서 검증한 것과 같은 것을 쓴다)
ROBOYAM_IMAGE=

# 관리자 앱 이미지 (server/admin/Dockerfile 로 만든 것) — 관리자 앱을 올리는 서버에서만 필요하다
# ROBOYAM_ADMIN_IMAGE=

# DB 서버(EC2, compose.db.yml — RDS 를 쓰지 않는다) 접속. 주소는 DB 서버의 사설 IP — 같은 VPC 라 SSL 없이 붙는다(5432 는 보안 그룹으로 앱·관리자 앱에만 연다)
DB_URL=jdbc:postgresql://<DB 서버 사설 IP>:5432/roboyam
DB_USERNAME=

# DB 서버(compose.db.yml)에서만 쓰는 값 — postgres 컨테이너는 평문 비밀번호가 필요하다(앱은 아래 DB_PASSWORD 암호문을 쓴다). 앱 서버의 .env 에는 넣지 않는다
# POSTGRES_PASSWORD=
# 데이터 볼륨 경로 — 별도 EBS 를 마운트한 폴더(비우면 도커 볼륨)
# PGDATA_DIR=/data/pgdata

# DB 비밀번호 — 평문이 아니라 암호문 ENC(...) 로 넣는다. 앱이 기동 때 ROBOYAM_CRYPTO_KEY 로 복호화한다.
# 암호문 만들기(비밀번호는 프롬프트로 입력받는다):
#   ROBOYAM_CRYPTO_KEY=<키> java -cp roboyam-api.jar -Dloader.main=com.community.zconfiguration.crypto.SecretCipherTool \
#        org.springframework.boot.loader.launch.PropertiesLauncher encrypt
DB_PASSWORD=

# 암호화 키 (base64 32바이트). 새로 만들기는 위와 같은 도구의 keygen.
# 앱 서버 2대(와 관리자 앱)가 같은 키를 써야 한다. 키를 잃으면 DB_PASSWORD 암호문을 풀 수 없으니 안전한 곳에 따로 백업한다.
# 암호문과 같은 곳(같은 파일·같은 저장소)에 오래 두지 않는다 — 가능하면 Secrets Manager 에서 주입한다
ROBOYAM_CRYPTO_KEY=

# 개인정보 칸(배송지·환불 계좌·탈퇴 회원 연락처) 암호화 키 — ROBOYAM_CRYPTO_KEY 와 따로 만든다. 형식 「<버전>:<base64 32바이트>」(처음은 1:<keygen 결과>).
# 모든 앱 서버와 관리자 앱이 같은 값이어야 한다. 잃으면 저장된 값을 영영 읽을 수 없다 — Secrets Manager 등에 따로 백업한다
ROBOYAM_DATA_KEY=
# 키를 교체할 때만: 새 키를 ROBOYAM_DATA_KEY(버전을 올려서)에, 옛 키를 여기에 쉼표로 둔다 — 키 교체 배치가 끝나면 비운다
ROBOYAM_DATA_KEY_PREVIOUS=
# 중복 확인 해시 키(본인인증·재가입 제한, base64 32바이트 — keygen 결과 그대로). 바꾸지 않는다. 따로 백업한다
ROBOYAM_INDEX_KEY=

# Snowflake ID 서버 번호 (0~1023) — 앱 서버 2대가 서로 다른 값이어야 ID 가 겹치지 않는다
# 이 파일을 두 서버에 복사한 뒤 서버마다 이 값만 다르게 고친다 (예: 서버 A = 1, 서버 B = 2)
NODE_ID=
# 관리자 앱(compose.admin.yml)의 Snowflake ID 서버 번호 — 공개 사이트 앱 서버 2대와 모두 달라야 한다 (예: 앱 1·2, 관리자 앱 3)
# ADMIN_NODE_ID=

# 설치 마법사(/install) 토큰 — 설치 전 서버에서 /install 에 입력한다. 비우면 서버가 뜰 때 무작위 토큰(24자)을 만들어 로그에 한 번 출력한다.
# 앱 서버를 여러 대 띄우면 직접 정한 긴 무작위 값(영숫자 . _ - 8~128자)을 모든 서버에 같게 준다. 설치가 끝나면 쓰이지 않는다.
# ROBOYAM_INSTALL_TOKEN=

# 관리자 앱 주소(http(s)://…) — 관리자 테마 화면 「실제 화면」(공개 사이트 iframe)을 이 주소에서만 허락하고(공개 사이트 앱), 초대·알림 메일의 관리자 링크가 된다(관리자 앱).
# 비우면 「실제 화면」이 뜨지 않고 운영자 초대 메일을 보내지 못한다. 관리자 화면의 「실제 화면」이 띄울 공개 사이트 주소는 이 값이 아니라 설치 때 정한 사이트 공개 주소다
# ADMIN_URL=https://admin.example.com

# (선택) 화면 주소 = 서비스 주소
# PUBLIC_URL=https://example.com

# 올린 이미지 저장소(docs/features/media-storage-contract.md) — s3(기본: S3 호환 버킷 — Cloudflare R2·AWS S3·MinIO) | local(아래 MEDIA_DIR 폴더)
# s3 설정이 틀리면(버킷·지역 없음, 키 한쪽만) 앱이 뜨지 않는다. 모든 앱 서버와 관리자 앱이 같은 값이어야 한다
ROBOYAM_STORAGE_TYPE=s3
# R2 = https://<계정 ID>.r2.cloudflarestorage.com, 비우면 AWS S3
ROBOYAM_STORAGE_S3_ENDPOINT=
# R2 = auto, AWS = ap-northeast-2
ROBOYAM_STORAGE_S3_REGION=auto
ROBOYAM_STORAGE_S3_BUCKET=
# MinIO 면 true
# ROBOYAM_STORAGE_S3_PATH_STYLE=false
# 새 이미지 주소의 머리(R2 사용자 도메인 — https://media.example.com). 비우면 /media/… 를 앱이 버킷에서 읽어 내보낸다
ROBOYAM_STORAGE_S3_PUBLIC_BASE_URL=
# 접근 키(이 버킷의 객체 읽기·쓰기만). 둘 다 비우면 기본 자격 증명(EC2 IAM 역할 — AWS S3). 비밀 키는 DB_PASSWORD 와 같은 도구로 만든 ENC(...) 로 넣는다
ROBOYAM_STORAGE_S3_ACCESS_KEY=
ROBOYAM_STORAGE_S3_SECRET_KEY=

# (선택) ROBOYAM_STORAGE_TYPE=local 일 때 올린 이미지를 두는 폴더 — 공개 사이트 앱 서버 2대와 관리자 앱이 같은 파일을 봐야 하므로 공유 디스크(NFS·EFS)의 경로를 준다.
# 비우면 서버마다 따로 있는 도커 볼륨이라 한 서버에 올린 이미지를 다른 서버가 못 읽는다(서버 한 대 구성에서만 괜찮다)
# MEDIA_DIR=/mnt/efs/roboyam-media

# (선택)
# DB_POOL_SIZE=20
# ADMIN_DB_POOL_SIZE=5
# ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=60
# JAVA_OPTS=-XX:MaxRAMPercentage=70
